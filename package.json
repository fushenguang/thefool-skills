{
  "name": "thefool-skills",
  "version": "0.1.0",
  "description": "Public Agent Skills content registry — MIT, attribution to www.fujia.site.",
  "engines": {
    "pnpm": ">=9",
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "turbo run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "check-types": "pnpm -r run check-types",
    "skills:sync": "node scripts/gates/manifest-fresh.mjs --write && node scripts/gen-skill-docs.mjs",
    "gate:validate": "node scripts/gates/validate-all.mjs",
    "gate:manifest-fresh": "node scripts/gates/manifest-fresh.mjs",
    "gate:public-boundary": "node scripts/gates/public-boundary.mjs",
    "gates": "pnpm run gate:validate && pnpm run gate:manifest-fresh && pnpm run gate:public-boundary"
  },
  "devDependencies": {
    "@cogito.ai/cli": "^0.8.1",
    "@fission-ai/openspec": "^1.3.1",
    "turbo": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@fission-ai/openspec",
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "license": "MIT"
}
